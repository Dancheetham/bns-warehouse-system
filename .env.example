# Copy this to .env and fill in real values. .env itself is gitignored - never
# commit real credentials.

POSTGRES_DB=bnswarehouse
POSTGRES_USER=bnsadmin
POSTGRES_PASSWORD=changeme

# Host-side ports (v0.107+) - only needed if the defaults below clash with
# something else already running on this machine (common on a shared home
# server). Leave commented out to use the defaults; uncomment and change just
# the ones you need. No docker-compose.yml edits required either way.
# API_PORT=8080
# FRONTEND_PORT=8081
# POSTGRES_PORT=5432

# Leave SMTP_HOST blank to run without email actually sending - the
# Acknowledgement/Despatch Confirmation actions will still compose and display
# the email content honestly as "not sent" rather than pretending to.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=sales@example.com

# Enables the "Reset Test Data" / "Clear Demo Products" buttons in Settings.
# Only ever appropriate for local/LAN test infrastructure - set to false (or
# remove) before this is ever pointed at real data.
ALLOW_TEST_DATA_RESET=true

# Shopify - see docs/ or the Shopify Sync page for how to obtain these
# (Dev Dashboard > your app > App settings > Credentials). Leave blank to run
# without Shopify sync at all.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

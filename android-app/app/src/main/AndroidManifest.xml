<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- To talk to the warehouse system over the LAN -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      For the Wi-Fi signal reading in the custom status bar. ACCESS_WIFI_STATE
      alone isn't enough on Android 8.1+ (API 27+) - the OS won't return a real
      RSSI/signal value without location permission too (Wi-Fi scan results
      can be used to infer location, so Android gates them behind it). This is
      a coarse-enough permission for that purpose - the app never actually
      uses GPS/location data for anything, only reads it as the unlock key for
      genuine Wi-Fi signal readings. Requested at runtime in MainActivity, not
      just declared here - it's a dangerous-level permission on API 23+.
    -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Kiosk"
        android:usesCleartextTraffic="true">
        <!--
          usesCleartextTraffic: needed because the warehouse system runs over
          plain http:// on the LAN, not https:// - Android blocks plaintext
          network traffic by default from API 28 onwards without this.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.Kiosk">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              HOME + DEFAULT together make this app a selectable Home app -
              pressing the Home button/gesture brings the device back here
              instead of the system launcher. Combined with the screen-pinning
              (startLockTask) in MainActivity, this is what stops a swipe-up-
              to-home from actually leaving the app.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>

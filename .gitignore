# Build artifacts
backend/target/
frontend/node_modules/
frontend/dist/

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Real credentials - .env holds them (Shopify secret, SMTP, DB password);
# .env.example is the committed template showing what's needed without values.
.env

# Android - local.properties is machine-specific (points at wherever Android
# Studio installed the SDK on that particular PC), never something to share
# between machines or commit.
android-app/local.properties
android-app/.gradle/
android-app/**/build/
android-app/.idea/
android-app/*.iml
android-app/**/*.iml

# The APK itself is a build output, not source - same reasoning as
# node_modules or target/. The folder's README (setup instructions) stays
# tracked.
android-app/releases/*.apk
